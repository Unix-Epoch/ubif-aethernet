{
 "v": 1,
 "rule": "oop-zero-cart",
 "check": "cart",
 "title": "OOP, $0 cart",
 "nodes": [
  {"id": "start", "type": "start", "x": 30, "y": 40},
  {"id": "scope", "type": "macro", "x": 30, "y": 180, "settings": {"macro": "checked"}},
  {"id": "wo", "type": "wo", "x": 30, "y": 300},
  {"id": "incomplete", "type": "statusIs", "x": 30, "y": 760, "settings": {"outcomes": ["Incomplete"]}},
  {"id": "rfpIncomplete", "type": "and", "x": 310, "y": 760},
  {"id": "notRfpIncomplete", "type": "not", "x": 590, "y": 760},
  {"id": "cartChecked", "type": "and", "x": 870, "y": 760},
  {"id": "inScope", "type": "branch", "x": 310, "y": 40},
  {"id": "cartOk", "type": "branch", "x": 590, "y": 40},
  {"id": "oop", "type": "programIs", "x": 590, "y": 180, "settings": {"programs": ["oop"]}},
  {"id": "isOop", "type": "branch", "x": 870, "y": 40},
  {"id": "skip", "type": "stop", "x": 1150, "y": 180},
  {"id": "sum", "type": "cartSum", "x": 310, "y": 320},
  {"id": "zero", "type": "atMost", "x": 590, "y": 320, "settings": {"limit": 0.009}},
  {"id": "why", "type": "matchesPattern", "x": 310, "y": 460, "settings": {"pattern": "EXPLAIN_RE", "skipNegated": true}},
  {"id": "whyLow", "type": "lowercase", "x": 590, "y": 460},
  {"id": "priced", "type": "matchesPattern", "x": 310, "y": 600, "settings": {"pattern": "DOLLAR_RE", "skipNegated": false}},
  {"id": "mentions", "type": "template", "x": 870, "y": 460, "settings": {"text": "Cart is $0; a note mentions {why}"}},
  {"id": "evidence", "type": "chooseText", "x": 1150, "y": 460, "settings": {"then2": "Cart is $0; the notes have a price", "else": "No price in the cart or in any note"}},
  {"id": "reason", "type": "chooseText", "x": 1150, "y": 720, "settings": {"then2": "priced-in-notes", "else": ""}},
  {"id": "cartSig", "type": "cartSig", "x": 870, "y": 320},
  {"id": "author", "type": "intakeAuthor", "x": 1150, "y": 980},
  {"id": "find", "type": "finding", "x": 1430, "y": 320, "settings": {"kind": "note"}}
 ],
 "wires": [
  {"from": "wo.outcome", "to": "incomplete.outcome"},
  {"from": "wo.isRfp", "to": "rfpIncomplete.a"},
  {"from": "incomplete.yes", "to": "rfpIncomplete.b"},
  {"from": "rfpIncomplete.out", "to": "notRfpIncomplete.in"},
  {"from": "wo.hasCart", "to": "cartChecked.a"},
  {"from": "notRfpIncomplete.out", "to": "cartChecked.b"},
  {"from": "scope.yes", "to": "inScope.cond"},
  {"from": "cartChecked.out", "to": "cartOk.cond"},
  {"from": "wo.programKey", "to": "oop.key"},
  {"from": "oop.yes", "to": "isOop.cond"},
  {"from": "wo.cart", "to": "sum.lines"},
  {"from": "sum.sum", "to": "zero.value"},
  {"from": "zero.yes", "to": "find.when"},
  {"from": "wo.noteText", "to": "why.text"},
  {"from": "why.match", "to": "whyLow.text"},
  {"from": "wo.noteText", "to": "priced.text"},
  {"from": "whyLow.out", "to": "mentions.why"},
  {"from": "why.found", "to": "evidence.if1"},
  {"from": "mentions.out", "to": "evidence.then1"},
  {"from": "priced.found", "to": "evidence.if2"},
  {"from": "evidence.out", "to": "find.evidence"},
  {"from": "why.found", "to": "reason.if1"},
  {"from": "whyLow.out", "to": "reason.then1"},
  {"from": "priced.found", "to": "reason.if2"},
  {"from": "wo.cart", "to": "cartSig.lines"},
  {"from": "cartSig.sig", "to": "find.sig1"},
  {"from": "reason.out", "to": "find.sig2"},
  {"from": "author.who", "to": "find.who"}
 ],
 "flow": [
  {"from": "start.then", "to": "inScope.in"},
  {"from": "inScope.yes", "to": "cartOk.in"},
  {"from": "inScope.no", "to": "skip.in"},
  {"from": "cartOk.yes", "to": "isOop.in"},
  {"from": "cartOk.no", "to": "skip.in"},
  {"from": "isOop.no", "to": "skip.in"}
 ]
}
